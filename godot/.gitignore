.godot/
*.tmp
*.log
.env
itch/
# Microsoft Store packages built by tools/build_msix.ps1
store/
tools/store_identity.json

# Old export outputs (current exports go to itch/)
/Campo de Fogo - Prototipo Godot.*
/aplicativo/
/WEB/

# Large source animations not used by the game (the game uses the .tres
# conversions). Kept on the local machine only.
/assets/personagens/jaime/animacoes/Downloads/
/assets/personagens/downloaded/movements/*.fbx
/assets/personagens/downloaded/movements/*.fbx.import
/assets/personagens/downloaded/movements/*.png
/assets/personagens/downloaded/movements/*.png.import

# Saidas com data do teste de fumaca do MCP do Godot (geradas a cada rodada).
tools/mcp-godot/.tmp-smoke-project/generation_jobs/

# Remy: FBX original do Mixamo e as texturas que o Godot extrai dele. O jogo usa
# só remy_modelo.scn + otimizado/*.png, gerados por
# godot/tools/characters/build_remy_model.gd a partir do FBX.
/assets/personagens/remy/remy.fbx
/assets/personagens/remy/remy.fbx.import
/assets/personagens/remy/remy_*.png
/assets/personagens/remy/remy_*.png.import

# UAL2 (Quaternius, CC0): biblioteca original. O jogo usa só ual2/clips/*.tres e
# manequim/manequim_modelo.scn, gerados por tools/characters/build_ual2_clips.gd
# e build_mannequin_model.gd a partir do GLB.
/assets/personagens/ual2/UAL2_Standard.glb
/assets/personagens/ual2/UAL2_Standard.glb.import
/assets/personagens/ual2/*.png
/assets/personagens/ual2/*.png.import
