; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Campo de Fogo - Prototipo Godot"
config/version="1.8.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/ai_mcp_bridge/plugin.cfg", "res://addons/little_helper/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/InterVariable.ttf"

[physics]

3d/default_gravity=22.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
