{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floral-haze-1c57",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  // Godot online: minimum client build (0.1.0 = 100) and where to download updates.
  // 300 = 0.3.0: online play needs an account (login + XP); older builds are told to update.
  // 400 = 0.4.0: rooms start by ready/leader (no timer), team rooms, medkits.
  // 500 = 0.5.0: grenades, 3 s medkit (heal_start), watchtower crate, lean, friends.
  // 903 = 0.9.3: everyone online on the itch release (ADS aim, 8-way unarmed locomotion).
  // 909 = 0.9.9: helmet/vest items, hit point (pt) for the hit check, ping/pong.
  // 10100 = 1.1.0: survival world 720 m (outer ring, parkour towns, new containers).
  "vars": {
    "GODOT_MIN_BUILD": "10400",
    "GODOT_DOWNLOAD_URL": "https://jaimexzz.itch.io/campo-de-fogo"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" },
      { "name": "GODOT_MATCHES", "class_name": "GodotMatch" },
      { "name": "GODOT_ACCOUNTS", "class_name": "GodotAccounts" },
      { "name": "GODOT_SURVIVAL", "class_name": "GodotSurvival" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["GodotMatch"] },
    { "tag": "v3", "new_sqlite_classes": ["GodotAccounts"] },
    { "tag": "v4", "new_sqlite_classes": ["GodotSurvival"] }
  ]
}