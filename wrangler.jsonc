{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floral-haze-1c57",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}